# Copy this file to `wrangler.toml` and fill in your own values.
#   cp wrangler.toml.example wrangler.toml
# `wrangler.toml` is gitignored so your account/database IDs stay private.

name = "uptime-guard-worker"
main = "src/index.ts"
compatibility_date = "2024-11-01"

# Optional when you're logged in via `wrangler login`. Find it with `wrangler whoami`.
# account_id = "your-cloudflare-account-id"

# Optional: serve the dashboard on your own domain. Remove this block to use the
# default *.workers.dev URL. The domain must be on this Cloudflare account.
# routes = [
#   { pattern = "status.example.com", custom_domain = true }
# ]

[triggers]
# Every minute: run due checks. Daily 03:00 UTC: roll up stats + prune old data.
crons = ["* * * * *", "0 3 * * *"]

[assets]
directory = "../dashboard/dist"
binding = "ASSETS"
not_found_handling = "single-page-application"

[[d1_databases]]
binding = "DB"
database_name = "uptime-guard"
# Paste the id printed by `wrangler d1 create uptime-guard`.
database_id = "your-d1-database-id"

# Secrets are NOT set here. Configure them with `wrangler secret put NAME`:
#   PASSWORD             login password
#   TOTP_SECRET          base32 authenticator secret   (npm run auth:setup)
#   SESSION_SECRET       random string for signing session tokens
#   TELEGRAM_BOT_TOKEN   from @BotFather                (optional, for alerts)
#   TELEGRAM_CHAT_ID     your chat/channel id           (optional, for alerts)
#   VAPID_PUBLIC         Web Push public key            (optional, for push)
#   VAPID_PRIVATE        Web Push private key           (optional, for push)
#   VAPID_SUBJECT        mailto:you@example.com         (optional, for push)
